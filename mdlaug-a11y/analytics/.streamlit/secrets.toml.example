# Copy to .streamlit/secrets.toml and fill in. (secrets.toml is gitignored.)

# Point at your Turso database directly (read-only token recommended):
TURSO_URL = "https://mdlaug-<org>.turso.io"
TURSO_AUTH_TOKEN = "your-turso-token"

# ...or point at your Cloudflare relay instead (same fields):
# TURSO_URL = "https://mdlaug-relay.<you>.workers.dev"
# TURSO_AUTH_TOKEN = "your-relay-AUTH_KEY"
