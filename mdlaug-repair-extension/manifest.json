{
  "manifest_version": 3,
  "name": "mDLAUG Repair — digital library accessibility",
  "version": "0.9.2",
  "description": "Repairs the 24 mDLAUG screen-reader barriers on any page and converts PDF/DOCX to accessible formats, all client-side.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "optional_host_permissions": ["*://*/*"],
  "host_permissions": ["https://*.turso.io/*", "http://127.0.0.1:8080/*", "http://localhost:8080/*"],
  "action": {
    "default_title": "mDLAUG Repair",
    "default_popup": "ui/popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_page": "ui/studio.html",
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["engine/remediator.js", "packs/blacklight.js", "packs/dspace.js", "packs/islandora.js", "packs/omeka.js", "packs/iiif.js", "engine/converter.js", "engine/compute.js", "engine/reader.js", "engine/assessment.js", "src/content.js"],
      "css": ["ui/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/*", "engine/*", "ui/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
